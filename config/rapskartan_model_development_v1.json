    "positive_crop": "Raps (höst)",
    "winter_crop_controls": ["Vete (höst)", "Korn (höst)", "Rågvete (höst)", "Råg"],
    "spring_crop_controls": ["Vete (vår)", "Korn (vår)", "Rågvete (vår)", "Havre"],
    "sampling_rule": "Deterministic municipality-balanced area-rank sampling within target year and crop group.",
    "population_weight_rule": "Eligible year/group count divided by selected year/group count."
