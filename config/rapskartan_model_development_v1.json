    "minimum_usable_observations": 2,
    "trend_window_days": 30,
    "causal_rule": "Every acquisition used by a feature row is on or before that row's cutoff date."
  },
  "sentinel2": {
    "collection": "sentinel-2-l2a",
    "resolution_m": 10,
    "mosaicking": "SIMPLE",
    "mosaicking_order": "leastCC",
    "max_scene_cloud_coverage_percent": 100,
    "harmonize_values": true,
