    "candidate_families": ["PRIOR_FREQUENCY_BASELINE", "LOGISTIC_REGRESSION", "RANDOM_FOREST"],
    "calibration_candidates": ["PLATT", "ISOTONIC"],
    "random_seed": 20260903,
    "random_forest": {
      "n_estimators": 160,
      "max_depth": 9,
      "min_samples_leaf": 5,
      "max_features": "sqrt",
